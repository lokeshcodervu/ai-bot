lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Sphinx documentation
doc/_build/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to ignore these files since the values are
#   specific to the developer's environment. However, for an application, you might
#   want to commit them to help others run the app.
# .python-version

# pipenv
#   According to pypa/pipenv#1053, keeping Pipfile.lock in version control is recommended.
#   However, if you're development is not restricted to one platform, lock files might
#   contain OS-specific packages.
#Pipfile.lock

# poetry
#   Similarly, Python-poetry recommends committing poetry.lock to shared-repository
#   poetry.lock

# pdm
#   PDM stores project-wide configurations in .pdm.toml, but it should be ignored if
#   it contains paths or credentials.
.pdm.toml
.pdm-python
.pdm-build/

# PEP 582; used by e.g. github.com/lincolnloop/layman and github.com/pdm-project/pdm
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

